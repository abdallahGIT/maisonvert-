# Postgres connection string (Neon via Vercel Storage, or Supabase)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Password for /admin
ADMIN_PASSWORD=choose-a-long-password
# Telegram bot (from @BotFather) and the chat id(s) to notify, comma-separated
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Osen: permanent API key from osenexpress.com > Paramètres > API (sent as Bearer, merchant ID as X-Api-Id)
OSEN_API_KEY=
